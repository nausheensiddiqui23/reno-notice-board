generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Notice {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(191)
  body        String   @db.Text
  category    String   @db.VarChar(100)
  priority    Int
  publishDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([priority])
  @@index([publishDate])
}
